{
  "name": "tango-news",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ingest": "python agentic-python/ingest.py",
    "publish-news": "python agentic-python/publish.py",
    "deploy": "astro build && wrangler pages deploy dist --project-name tango-news"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
