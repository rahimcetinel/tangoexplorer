{
  "name": "tango-news",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ingest": "python agentic-python/ingest.py",
    "ingest-hoy": "python agentic-python/ingest_hoy.py",
    "ingest-tangoverse": "python agentic-python/ingest_tangoverse.py",
    "ingest-tmd": "python agentic-python/ingest_tmd.py",
    "publish-news": "python agentic-python/publish.py",
    "audit:data": "python agentic-python/audit_data.py",
    "check:links": "python agentic-python/check_links.py",
    "check:palette": "node agentic-python/palette-tokens.mjs",
    "check:palette:live": "node agentic-python/palette-audit.mjs --check",
    "mockup": "node agentic-python/build-mockup.mjs",
    "deploy": "astro build && wrangler pages deploy dist --project-name tango-news",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "check:visual": "node agentic-python/visual-check.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "wrangler": "^4.129.0"
  }
}
