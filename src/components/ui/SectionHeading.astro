---
interface Props {
  level?: 2 | 3;
  class?: string;
}

const { level = 2, class: className } = Astro.props;
---

{
  level === 3 ? (
    <h3 class:list={['app-rail-label', className]}>
      <slot />
    </h3>
  ) : (
    <h2 class:list={['app-rail-label', className]}>
      <slot />
    </h2>
  )
}
