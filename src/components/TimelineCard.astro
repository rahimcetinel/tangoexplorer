---
import Card from './ui/Card.astro';
import EventImage from './EventImage.astro';
import { categoryLabels, kindLabels, newsPath, type Locale } from '../lib/i18n';
import { newsSlug, type NewsEntry } from '../lib/news';
import { dayLabel, initials } from '../lib/timeline';
import { eventImage } from '../lib/images';
import { regionLabels, regionOf } from '../lib/regions';
import { countryHue } from '../lib/country-color';

interface Props {
  post: NewsEntry;
  locale: Locale;
  selected?: string;
}

const { post, locale, selected } = Astro.props;
const slug = newsSlug(post);
const href = newsPath(locale, slug);
const labels = categoryLabels[locale];
const kinds = kindLabels[locale];
const kind = post.data.kinds[0];
const region = regionOf(post.data.country);
const regionLabel = region ? regionLabels[locale][region] : labels[post.data.category];
const day = dayLabel(post.data.eventStart, post.data.eventEnd);
const place = post.data.eventLocation || [post.data.city, post.data.country].filter(Boolean).join(', ');
const isSelected = selected === slug;
const meta = eventImage(post.data.image);
const hue = countryHue(post.data.country);
---

<Card
  selected={isSelected}
  data-card
  data-category={post.data.category}
  data-region={region ?? ''}
>
  <a href={href} data-detail-link>
    <div class:list={['app-ev-ph', !meta && 'noimg']} data-initials={initials(post.data.title)}>
      <EventImage src={post.data.image} alt="" initialsFrom={post.data.title} sizes="252px" />
      {day && <span class="app-ev-day">{day}</span>}
    </div>
    <div class="app-ev-in">
      <p class="app-ev-cat">
        {regionLabel}
        {kind && <> · {kinds[kind]}</>}
      </p>
      <h3>{post.data.title}</h3>
      {place && (
        <p class:list={['app-ev-loc', hue && 'is-country']} style={hue ? `--cc-h:${hue}` : undefined}>
          {place}
        </p>
      )}
    </div>
  </a>
</Card>
