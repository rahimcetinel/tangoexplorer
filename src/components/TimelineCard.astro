---
import Card from './ui/Card.astro';
import EventImage from './EventImage.astro';
import { Picture } from 'astro:assets';
import { categoryLabels, kindLabels, newsPath, type Locale } from '../lib/i18n';
import { newsSlug, type NewsEntry } from '../lib/news';
import { formatEventRange } from '../lib/timeline';
import { eventImage } from '../lib/images';
import { regionLabels, regionOf } from '../lib/regions';
import { countryColor } from '../lib/country-color';
import { fallbackImage } from '../lib/fallback';

interface Props {
  post: NewsEntry;
  locale: Locale;
  selected?: string;
}

const { post, locale, selected } = Astro.props;
const slug = newsSlug(post);
const href = newsPath(locale, slug);
const labels = categoryLabels[locale];
const kinds = kindLabels[locale];
const kind = post.data.kinds[0];
const region = regionOf(post.data.country);
const regionLabel = region ? regionLabels[locale][region] : labels[post.data.category];
const dateRange = formatEventRange(post.data.eventStart, post.data.eventEnd, { year: false });
const altText = post.data.eventName || post.data.title;
const place = post.data.eventLocation || [post.data.city, post.data.country].filter(Boolean).join(', ');
const isSelected = selected === slug;
const meta = eventImage(post.data.image);
const color = countryColor(post.data.country);
---

<Card
  selected={isSelected}
  data-card
  data-category={post.data.category}
  data-region={region ?? ''}
>
  <a href={href} data-detail-link>
    <div class="app-ev-ph">
      {meta ? (
        <EventImage src={post.data.image} alt={altText} initialsFrom={post.data.title} sizes="(min-width: 1100px) 252px, (min-width: 640px) 30vw, 44vw" />
      ) : (
        <Picture
          src={fallbackImage(slug)}
          alt={altText}
          formats={['avif', 'webp']}
          widths={[252, 408, 816]}
          sizes="(min-width: 1100px) 252px, (min-width: 640px) 30vw, 44vw"
          loading="lazy"
          decoding="async"
          class:list={['event-image', 'app-ev-fallback']}
        />
      )}
      {dateRange && <span class="app-ev-day" title={dateRange}>{dateRange}</span>}
    </div>
    <div class="app-ev-in">
      <p class="app-ev-cat">
        {regionLabel}
        {kind && <> · {kinds[kind]}</>}
      </p>
      <h3>{post.data.title}</h3>
      {place && (
        <p class:list={['app-ev-loc', color && 'is-country']} style={color ? `--cc:${color}` : undefined}>
          {place}
        </p>
      )}
      {post.data.registrationStart && post.data.registrationStart <= new Date() && (
        <span class="app-ev-open">Registration open</span>
      )}
    </div>
  </a>
  <button
    type="button"
    class="app-save app-ev-save"
    data-save={slug}
    aria-pressed="false"
    aria-label="Save this event"
  >
    <span data-save-icon aria-hidden="true">☆</span>
  </button>
</Card>
