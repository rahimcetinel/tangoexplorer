---
import Button from './ui/Button.astro';
import { newsPath, ui, type Locale } from '../lib/i18n';
import { newsSlug, type NewsEntry } from '../lib/news';
import { buildIcs, googleCalendarUrl, icsHref } from '../lib/calendar';

interface Props {
  locale: Locale;
  post: NewsEntry;
  pageUrl: string;
  permalink?: boolean;
}

const { locale, post, pageUrl, permalink = false } = Astro.props;
const copy = ui[locale];
const d = post.data;
const slug = newsSlug(post);
const start = d.eventStart;
const place = d.eventLocation || [d.city, d.country].filter(Boolean).join(', ');
const title = d.eventName || d.title;
const website = d.eventWebsite;
const ics = start
  ? buildIcs({
      uid: slug,
      title,
      description: d.summary,
      location: place,
      url: pageUrl,
      start,
      end: d.eventEnd,
    })
  : '';
const google = start
  ? googleCalendarUrl({
      title,
      details: d.summary,
      location: place,
      start,
      end: d.eventEnd,
    })
  : '';
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${title} ${pageUrl}`)}`;
const telegram = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(title)}`;
---

<div class="app-actions">
  {
    website && (
      <Button variant="solid" href={website} target="_blank" rel="noopener noreferrer">
        {copy.eventWebsite}
      </Button>
    )
  }
  {
    start && (
      <Button variant={website ? 'ghost' : 'solid'} href={icsHref(ics)} download={`${slug}.ics`}>
        {copy.addToCalendar}
      </Button>
    )
  }
  {
    start && (
      <Button href={google} target="_blank" rel="noopener noreferrer">
        {copy.googleCalendar}
      </Button>
    )
  }
</div>
<div class="app-actions">
  <Button
    data-share
    data-share-url={pageUrl}
    data-share-title={d.title}
    data-copied={copy.linkCopied}
    data-copy-label={copy.copyLink}
  >
    {copy.share}
  </Button>
  <a class="app-btn" href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  <a class="app-btn" href={telegram} target="_blank" rel="noopener noreferrer">Telegram</a>
  {
    permalink && (
      <Button href={newsPath(locale, slug)}>{copy.openPage}</Button>
    )
  }
</div>
