---
import MenuPanel from './MenuPanel.astro';
import { aboutPath, homePath, milongasPath, ui, type Locale } from '../lib/i18n';
import type { NewsEntry } from '../lib/news';
import { countByRegion, regionLabels, regionPath, regions } from '../lib/regions';

interface Props {
  locale: Locale;
  mode: 'home' | 'category' | 'milonga' | 'page';
  posts: NewsEntry[];
}

const { locale, mode, posts } = Astro.props;
const copy = ui[locale];
const home = homePath(locale);
const currentPath = Astro.url.pathname;
const showSearch = mode === 'home' || mode === 'category' || mode === 'milonga';
const counts = countByRegion(posts);
const regionsActive = currentPath.startsWith('/region');
const today = new Intl.DateTimeFormat('en-GB', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date());
// Short form for phones: the long one is clipped next to the brand.
const todayShort = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
}).format(new Date());
---

<div class="app-head" data-app-head>
  <header class="app-topbar">
    <button
      type="button"
      class="app-menu-square"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="app-menu"
      aria-label={copy.menu}
    >
      <span class="app-burger" aria-hidden="true"></span>
    </button>
    <a class="app-brand" href={home}>
      {copy.brandLead}<em>{copy.brandAccent}</em>
    </a>
    <span class="app-topbar-date" title={today}>
      <span class="is-wide">{today}</span>
      <span class="is-narrow">{todayShort}</span>
    </span>
    <nav class="app-topnav" aria-label={copy.browse}>
      <a href={home} class:list={[currentPath === home && 'is-active']}>{copy.home}</a>
      <a
        href={regionPath(locale, 'turkiye')}
        class:list={[currentPath === regionPath(locale, 'turkiye') && 'is-active']}
      >
        {regionLabels[locale].turkiye}
      </a>
      <details class="app-regions">
        <summary class:list={[regionsActive && 'is-active']}>{copy.regions}</summary>
        <div class="app-regions-panel">
          {
            regions
              .filter((region) => region !== 'turkiye')
              .map((region) => (
              <a
                href={regionPath(locale, region)}
                class:list={[currentPath === regionPath(locale, region) && 'is-active']}
              >
                <span>{regionLabels[locale][region]}</span>
                <b>{counts[region]}</b>
              </a>
            ))
          }
        </div>
      </details>
      <a
        href={milongasPath(locale)}
        class:list={[currentPath === milongasPath(locale) && 'is-active']}
      >
        {copy.milongas}
      </a>
      <a href={aboutPath(locale)} class:list={[currentPath === aboutPath(locale) && 'is-active']}>
        {copy.about}
      </a>
    </nav>
    <div class="app-topbar-right">
      {
        showSearch && (
          <div class="app-search">
            <label class="app-search-field">
              <span class="sr-only">{copy.searchLabel}</span>
              <input type="search" data-search-input placeholder={copy.searchPlaceholder} autocomplete="off" />
            </label>
            <div class="app-suggest" data-suggest role="listbox" hidden />
          </div>
        )
      }
    </div>
  </header>
</div>

<div class="app-menupanel" id="app-menu" data-menu-panel hidden>
  <MenuPanel locale={locale} mode={mode} posts={posts} />
</div>
<div class="app-menu-backdrop" data-menu-backdrop hidden></div>

<script>
  import { initTopBar } from '../scripts/top-bar';
  initTopBar();
</script>
