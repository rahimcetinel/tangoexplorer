---
import AppShell from '../layouts/AppShell.astro';
import Header from '../components/Header.astro';
import milongaData from '../data/hoy-milongas.json';
import { getNews, newsSlug } from '../lib/news';
import { homePath, kindLabels, monthShort, ui } from '../lib/i18n';
import type { HoyData, Milonga } from '../lib/hoy';

const copy = ui.en;
const posts = await getNews('en');
const milongas = ((milongaData as HoyData).items ?? []) as Milonga[];

const events = posts.map((post) => ({
  s: newsSlug(post),
  t: post.data.title,
  st: post.data.eventStart ? post.data.eventStart.toISOString().slice(0, 10) : '',
  en: (post.data.eventEnd ?? post.data.eventStart)?.toISOString().slice(0, 10) ?? '',
  ci: post.data.city ?? '',
  co: post.data.country ?? '',
  k: post.data.kinds[0] ? kindLabels.en[post.data.kinds[0]] : '',
  w: post.data.eventLocation ?? [post.data.city, post.data.country].filter(Boolean).join(', '),
}));

const slimMilongas = milongas.map((item) => ({
  n: item.name,
  c: item.city,
  d: item.days,
  s: item.start,
  e: item.end,
  v: item.venue,
  ty: item.type,
  r: item.region,
}));

const day = 86_400_000;
const today = new Date();
const friday = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));
const weekday = friday.getUTCDay();
friday.setUTCDate(friday.getUTCDate() + ((5 - weekday + 7) % 7));
const weekends: { value: string; label: string }[] = [];
for (let index = 0; index < 12; index += 1) {
  const start = new Date(friday.getTime() + index * 7 * day);
  const end = new Date(start.getTime() + 2 * day);
  weekends.push({
    value: start.toISOString().slice(0, 10),
    label: `Fri ${start.getUTCDate()} – Sun ${end.getUTCDate()} ${monthShort.en[end.getUTCMonth()]}`,
  });
}

const cities = [
  ...new Set([
    ...posts.map((post) => post.data.city).filter((city): city is string => Boolean(city)),
    ...milongas.map((item) => item.city).filter(Boolean),
  ]),
].sort((a, b) => a.localeCompare(b, 'en'));
---

<AppShell
  title={`Plan a tango weekend — ${copy.brand}`}
  description="Pick a city and a weekend to see the tango events and milongas happening then."
  locale="en"
  mode="page"
  posts={posts}
>
  <Fragment slot="center">
    <Header
      locale="en"
      crumbs={[
        { label: copy.home, href: homePath('en') },
        { label: 'Plan a weekend' },
      ]}
    />
    <main id="main" class="app-page plan-page" data-plan-page>
      <h1 class="app-page-title">Plan a tango weekend</h1>
      <p class="app-prose">
        Pick a city and a weekend. We show the festivals and marathons that overlap those dates, plus the
        milongas that run on Friday, Saturday or Sunday.
      </p>

      <form class="app-plan-form" action="/plan" method="get" data-plan-form>
        <label class="app-plan-field">
          <span>City</span>
          <input
            type="text"
            name="city"
            list="plan-cities"
            placeholder="Istanbul, Berlin, Buenos Aires…"
            autocomplete="off"
            data-plan-city
          />
        </label>
        <label class="app-plan-field">
          <span>Weekend</span>
          <select name="weekend" data-plan-weekend>
            {weekends.map((weekend) => <option value={weekend.value}>{weekend.label}</option>)}
          </select>
        </label>
        <button class="app-btn app-btn-solid" type="submit">Show weekend</button>
      </form>
      <datalist id="plan-cities">
        {cities.map((city) => <option value={city} />)}
      </datalist>

      <p class="app-plan-summary" data-plan-summary aria-live="polite"></p>
      <div class="app-plan-results" data-plan-results></div>
      <noscript>
        <p class="app-prose">The planner needs JavaScript. You can still browse the calendar and milongas.</p>
      </noscript>

      <script type="application/json" data-plan-events set:html={JSON.stringify(events)} />
      <script type="application/json" data-plan-milongas set:html={JSON.stringify(slimMilongas)} />
    </main>
  </Fragment>
</AppShell>
<script>
  import { initPlan } from '../scripts/plan';
  initPlan();
</script>
