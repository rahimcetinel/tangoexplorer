---
import AppShell from '../layouts/AppShell.astro';
import Header from '../components/Header.astro';
import { MILONGAS } from '../lib/milongas';
import { getNews, newsSlug } from '../lib/news';
import { homePath, kindLabels, ui } from '../lib/i18n';
import type { Milonga } from '../lib/hoy';

const copy = ui.en;
const posts = await getNews('en');
const milongas = MILONGAS as Milonga[];

const events = posts.map((post) => ({
  s: newsSlug(post),
  t: post.data.title,
  st: post.data.eventStart ? post.data.eventStart.toISOString().slice(0, 10) : '',
  en: (post.data.eventEnd ?? post.data.eventStart)?.toISOString().slice(0, 10) ?? '',
  ci: post.data.city ?? '',
  co: post.data.country ?? '',
  k: post.data.kinds[0] ? kindLabels.en[post.data.kinds[0]] : '',
  w: post.data.eventLocation ?? [post.data.city, post.data.country].filter(Boolean).join(', '),
}));

const slimMilongas = milongas.map((item) => ({
  n: item.name,
  c: item.city,
  d: item.days,
  s: item.start,
  e: item.end,
  v: item.venue,
  ty: item.type,
  r: item.region,
}));

// Default plan: the coming Friday to the Sunday after it.
const day = 86_400_000;
const today = new Date();
const first = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()));
first.setUTCDate(first.getUTCDate() + ((5 - first.getUTCDay() + 7) % 7));
const defaultStart = first.toISOString().slice(0, 10);
const defaultEnd = new Date(first.getTime() + 2 * day).toISOString().slice(0, 10);
---

<AppShell
  title={`Plan a tango experience — ${copy.brand}`}
  description="Pick a city and your dates to see the tango events and milongas happening then."
  locale="en"
  mode="page"
  posts={posts}
>
  <Fragment slot="center">
    <Header
      locale="en"
      crumbs={[
        { label: copy.home, href: homePath('en') },
        { label: 'Plan an experience' },
      ]}
    />
    <main id="main" class="app-page plan-page" data-plan-page>
      <h1 class="app-page-title">Plan a tango experience</h1>
      <p class="app-prose">
        Pick a city and your dates. We show the festivals and marathons that overlap that window, plus the
        milongas that run on those days.
      </p>

      <form class="app-plan-form" action="/plan" method="get" data-plan-form>
        <label class="app-plan-field">
          <span>City</span>
          <span class="app-plan-combo">
            <input
              type="text"
              name="city"
              placeholder="Istanbul, Berlin, Buenos Aires…"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="plan-city-suggest"
              data-plan-city
            />
            <div class="app-suggest" id="plan-city-suggest" role="listbox" data-plan-suggest hidden></div>
          </span>
        </label>
        <label class="app-plan-field">
          <span>Start date</span>
          <input type="date" name="start" value={defaultStart} data-plan-start />
        </label>
        <label class="app-plan-field">
          <span>End date</span>
          <input type="date" name="end" value={defaultEnd} data-plan-end />
        </label>
        <button class="app-btn app-btn-solid" type="submit">Show plan</button>
      </form>

      <p class="app-plan-summary" data-plan-summary aria-live="polite"></p>
      <div class="app-plan-results" data-plan-results></div>
      <noscript>
        <p class="app-prose">The planner needs JavaScript. You can still browse the calendar and milongas.</p>
      </noscript>

      <script type="application/json" data-plan-events set:html={JSON.stringify(events)} />
      <script type="application/json" data-plan-milongas set:html={JSON.stringify(slimMilongas)} />
    </main>
  </Fragment>
</AppShell>
<script>
  import { initPlan } from '../scripts/plan';
  initPlan();
</script>
