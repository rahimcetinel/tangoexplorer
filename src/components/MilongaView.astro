---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import milongaData from '../data/hoy-milongas.json';
import { getNews } from '../lib/news';
import { milongasPath, ui, type Locale } from '../lib/i18n';
import type { HoyData, Milonga } from '../lib/hoy';
import {
  cityColorsFor,
  defaultFilters,
  detailHtml,
  listHtml,
  tabsHtml,
  tonightCount,
} from '../lib/milonga-html';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getNews(locale);
const items = ((milongaData as HoyData).items ?? []) as Milonga[];
const filters = defaultFilters(items);
const cityColors = cityColorsFor(items, filters.region);
const total = items.filter((item) => item.region === filters.region).length;
const tonight = tonightCount(items, filters.region);
---

<AppShell
  title={`${copy.milongaTitle} — ${copy.brand}`}
  description={copy.milongaIntro}
  locale={locale}
  mode="milonga"
  closePath={milongasPath(locale)}
  posts={posts}
>
  <Fragment slot="center">
    <Header locale={locale} />
    <main id="main" class="app-main-board app-milonga">
      <p class="app-milonga-summary" data-milonga-summary>
        <b data-milonga-total>{total}</b> {copy.milongaCount}
        <span aria-hidden="true">·</span>
        <b data-milonga-tonight>{tonight}</b> {copy.milongaTonight}
      </p>
      <div class="app-milonga-tabs" data-milonga-tabs set:html={tabsHtml(items, filters, locale, copy)} />
      <div
        class="app-milonga-list"
        data-milonga-list
        set:html={listHtml(items, filters, locale, copy, cityColors, null)}
      />
      <p class="app-empty" data-milonga-empty hidden>{copy.milongaEmpty}</p>
    </main>
    <script type="application/json" data-milonga-data set:html={JSON.stringify(items)} />
  </Fragment>
  <Fragment slot="detail">
    <div class="app-detail-inner" data-milonga-detail set:html={detailHtml(null, locale, copy)} />
  </Fragment>
</AppShell>
<script>
  import { initMilongas } from '../scripts/milongas';
  initMilongas();
</script>
