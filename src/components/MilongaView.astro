---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import milongaData from '../data/hoy-milongas.json';
import { getNews } from '../lib/news';
import { milongasPath, monthShort, ui, type Locale } from '../lib/i18n';
import type { HoyData, Milonga } from '../lib/hoy';
import { HOY_REGIONS, regionLabel } from '../lib/hoy';
import {
  cityChipsHtml,
  cityColorsFor,
  defaultFilters,
  detailHtml,
  listHtml,
  tabsHtml,
  tonightCount,
} from '../lib/milonga-html';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getNews(locale);
const items = ((milongaData as HoyData).items ?? []) as Milonga[];
const filters = defaultFilters(items);
const cityColors = cityColorsFor(items, filters.region);
const total = items.filter((item) => item.region === filters.region).length;
const tonight = tonightCount(items, filters.region);
const generated = new Date((milongaData as HoyData).generatedAt);
const updatedAt = `${generated.getUTCDate()} ${monthShort.en[generated.getUTCMonth()]} ${generated.getUTCFullYear()}`;
---

<AppShell
  title={`${copy.milongaTitle} — ${copy.brand}`}
  description={copy.milongaIntro}
  locale={locale}
  mode="milonga"
  closePath={milongasPath(locale)}
  posts={posts}
>
  <Fragment slot="center">
    <Header locale={locale} />
    <main id="main" class="app-main-board app-milonga">
      <h1 class="sr-only">{copy.milongaTitle}</h1>
      <p class="app-milonga-summary" data-milonga-summary>
        <b data-milonga-total>{total}</b> {copy.milongaCount}
        <span aria-hidden="true">·</span>
        <button type="button" class="app-milonga-tonight" data-milonga-tonight>
          <b data-milonga-tonight-count>{tonight}</b> {copy.milongaTonight}
        </button>
        <span class="app-milonga-updated">{copy.milongaUpdatedOn} {updatedAt}</span>
      </p>
      <div class="app-milonga-toolbar">
        <label class="app-milonga-region">
          <span class="sr-only">{copy.milongaRegion}</span>
          <select data-milonga-region-top>
            {
              HOY_REGIONS.map((region) => (
                <option value={region.id} selected={region.id === filters.region}>
                  {regionLabel(region.id, 'en')}
                </option>
              ))
            }
          </select>
        </label>
        <div class="app-milonga-cities" data-milonga-cities set:html={cityChipsHtml(items, filters, copy)} />
      </div>
      <div class="app-milonga-tabs" data-milonga-tabs set:html={tabsHtml(items, filters, locale, copy)} />
      <div
        class="app-milonga-list"
        data-milonga-list
        set:html={listHtml(items, filters, locale, copy, cityColors, null)}
      />
      <p class="app-empty" data-milonga-empty hidden>{copy.milongaEmpty}</p>
    </main>
    <script type="application/json" data-milonga-data set:html={JSON.stringify(items)} />
  </Fragment>
  <Fragment slot="detail">
    <div class="app-detail-inner" data-milonga-detail set:html={detailHtml(null, locale, copy)} />
  </Fragment>
</AppShell>
<script>
  import { initMilongas } from '../scripts/milongas';
  initMilongas();
</script>
