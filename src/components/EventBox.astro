---
import ExternalLink from './ExternalLink.astro';
import EventImage from './EventImage.astro';
import type { NewsEntry } from '../lib/news';
import { healthFor, relativeCheck } from '../lib/link-health';
import { formatNewsDate, kindLabels, ui, type Locale } from '../lib/i18n';
import { formatEventRange } from '../lib/timeline';

interface Props {
  post: NewsEntry;
  locale: Locale;
  duration?: number | null;
  showImage?: boolean;
}

const { post, locale, duration, showImage = true } = Astro.props;
const copy = ui[locale];
const d = post.data;
const kinds = kindLabels[locale];
const kind = d.kinds[0];
const place = d.eventLocation || [d.city, d.country].filter(Boolean).join(', ');
const cityCountry = [d.city, d.country].filter(Boolean).join(', ');
// The place line already spells out the city for most entries; only repeat it
// when it adds something ("City: Istanbul, Turkey" next to "Turkey, Istanbul"
// was pure noise).
const cityAlreadyShown = Boolean(d.city && place.toLowerCase().includes(d.city.toLowerCase()));
const showCityCountry = Boolean(cityCountry && cityCountry !== place && !cityAlreadyShown);
const dates = formatEventRange(d.eventStart, d.eventEnd) || d.eventWhen || '';
const registrationOpen = Boolean(d.registrationStart && d.registrationStart <= new Date());
const hasEvent = Boolean(dates || place || d.eventWebsite || d.eventFacebook || d.eventInstagram || d.image || duration || kind || d.edition != null || d.registrationStart);
const webDistinct = d.eventWebsite && d.eventWebsite.replace(/\/$/, '') !== d.sourceUrl.replace(/\/$/, '');
const sourceHealth = healthFor(d.sourceUrl, d.eventWebsite);
const hasLinks = Boolean(webDistinct || d.eventFacebook || d.eventInstagram);
const mapHref = place
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(place)}`
  : '';

function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
}
---

{
  (hasEvent || d.sourceUrl) && (
    <aside class="app-facts-box" id="facts">
      {showImage && d.image && (
        <div class="app-facts-img">
          <EventImage
            src={d.image}
            alt={d.eventName ? `${d.eventName}` : copy.eventImage}
            initialsFrom={d.eventName || d.title}
            sizes="408px"
          />
        </div>
      )}
      <div class="app-facts-grid">
        {hasEvent && (
          <div>
            <h2 class="app-facts-label">{copy.event}</h2>
            {d.eventName && <p class="app-facts-name">{d.eventName}</p>}
            <dl class="app-facts-dl">
              {dates && (
                <div>
                  <dt>{copy.date}</dt>
                  <dd>{dates}</dd>
                </div>
              )}
              {place && (
                <div>
                  <dt>{copy.place}</dt>
                  <dd>
                    {mapHref ? (
                      <a class="app-link" href={mapHref} target="_blank" rel="noopener noreferrer">
                        {place}
                      </a>
                    ) : (
                      place
                    )}
                  </dd>
                </div>
              )}
              {showCityCountry && (
                <div>
                  <dt>{copy.filterCity}</dt>
                  <dd>{cityCountry}</dd>
                </div>
              )}
              {kind && (
                <div>
                  <dt>{copy.kind}</dt>
                  <dd>{kinds[kind]}</dd>
                </div>
              )}
              {duration != null && duration > 0 && (
                <div>
                  <dt>{copy.duration}</dt>
                  <dd>{copy.durationDays(duration)}</dd>
                </div>
              )}
              {d.edition != null && (
                <div>
                  <dt>{copy.edition}</dt>
                  <dd>{d.edition}</dd>
                </div>
              )}
              {d.registrationStart && (
                <div>
                  <dt>{registrationOpen ? copy.registrationOpen : copy.registrationOpens}</dt>
                  <dd>{registrationOpen ? copy.registrationOpenNow : formatNewsDate(d.registrationStart, locale)}</dd>
                </div>
              )}
            </dl>
            {mapHref && (
              <p class="app-map-link">
                <a class="app-link" href={mapHref} target="_blank" rel="noopener noreferrer">
                  {copy.openInMaps}
                </a>
              </p>
            )}
          </div>
        )}
        <div id="links">
          {hasLinks && (
            <>
              <h2 class="app-facts-label">{copy.links}</h2>
              <ul class="app-links">
                {webDistinct && (
                  <li>
                    {copy.web}:
                    <ExternalLink class="app-link" href={d.eventWebsite!}>
                      {hostOf(d.eventWebsite!)}
                    </ExternalLink>
                  </li>
                )}
                {d.eventInstagram && (
                  <li>
                    Instagram:
                    <ExternalLink class="app-link" href={d.eventInstagram}>
                      {hostOf(d.eventInstagram)}
                    </ExternalLink>
                  </li>
                )}
                {d.eventFacebook && (
                  <li>
                    Facebook:
                    <ExternalLink class="app-link" href={d.eventFacebook}>
                      {hostOf(d.eventFacebook)}
                    </ExternalLink>
                  </li>
                )}
              </ul>
            </>
          )}
          <div class:list={['app-source', hasLinks && 'has-links']}>
            <p class="app-facts-label">{copy.source}</p>
            <p>
              {d.source}:{' '}
              <ExternalLink class="app-link" href={d.sourceUrl}>
                {hostOf(d.sourceUrl)}
              </ExternalLink>
              {sourceHealth?.status === 'ok' && (
                <span class="app-source-check"> · checked {relativeCheck(sourceHealth.checkedAt)}</span>
              )}
            </p>
            {sourceHealth?.status === 'dead' && (
              <p class="app-source-warn">This source link looks broken; use the organiser link above.</p>
            )}
          </div>
        </div>
      </div>
    </aside>
  )
}
