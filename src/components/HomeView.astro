---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import MonthRibbon from './MonthRibbon.astro';
import TimelineBoard from './TimelineBoard.astro';
import DetailPanel from './DetailPanel.astro';
import ArticleInner from './ArticleInner.astro';
import EmptyState from './ui/EmptyState.astro';
import { getNews, newsSlug } from '../lib/news';
import { ui, type Locale } from '../lib/i18n';
import { eagerMonthKeys, groupByMonth } from '../lib/timeline';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getNews(locale);
const months = groupByMonth(posts, locale);
const selected = posts[0];
const selectedSlug = selected ? newsSlug(selected) : undefined;
const eagerMonths = eagerMonthKeys(selected);
const title =
  locale === 'en' ? 'TangoExplorer — Argentine tango news' : 'TangoExplorer — Arjantin tangosu haberleri';
---

<AppShell title={title} locale={locale} mode="home" posts={posts}>
  <Fragment slot="center">
    <h1 class="sr-only">{copy.brand}</h1>
    <Header locale={locale} />
    <MonthRibbon locale={locale} months={months} />
    <main id="main" class="app-main-board">
      <TimelineBoard locale={locale} months={months} selectedSlug={selectedSlug} eagerMonths={eagerMonths} />
      <EmptyState data-filter-empty hidden>{copy.filterEmpty}</EmptyState>
    </main>
  </Fragment>
  <Fragment slot="detail">
    <DetailPanel locale={locale}>
      {selected ? <ArticleInner locale={locale} post={selected} variant="panel" /> : <EmptyState>{copy.filterEmpty}</EmptyState>}
    </DetailPanel>
  </Fragment>
</AppShell>
<script>
  import { initAppShell } from '../scripts/app-shell';
  initAppShell();
</script>
