---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import { getBoardNews, newsSlug } from '../lib/news';
import { formatEventRange } from '../lib/timeline';
import { homePath, newsPath, ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getBoardNews(locale);
const home = homePath(locale);
const upcoming = posts.slice(0, 3);
---

<AppShell
  title={`${copy.notFoundTitle} — ${copy.brand}`}
  description={copy.notFoundLead}
  locale={locale}
  posts={posts}
  robots="noindex"
>
  <Fragment slot="center">
    <Header
      locale={locale}
      crumbs={[
        { label: copy.home, href: home },
        { label: copy.notFoundTitle },
      ]}
    />
    <main id="main" class="app-page">
      <h1 class="app-page-title">{copy.notFoundTitle}</h1>
      <p class="app-prose">{copy.notFoundLead}</p>

      <form class="app-hero-search" action="/" method="get" role="search">
        <label class="sr-only" for="notfound-q">{copy.searchLabel}</label>
        <input
          id="notfound-q"
          type="search"
          name="q"
          placeholder={copy.heroSearchPlaceholder}
          autocomplete="off"
        />
        <button type="submit">{copy.heroSearchCta}</button>
      </form>

      <h2 class="app-facts-label mt-8">{copy.notFoundUpcoming}</h2>
      <ul class="app-links">
        {
          upcoming.map((post) => {
            const range = formatEventRange(post.data.eventStart, post.data.eventEnd);
            return (
              <li>
                <a class="app-link" href={newsPath(locale, newsSlug(post))}>
                  {post.data.title}
                </a>
                {range && <span class="text-ink-soft"> · {range}</span>}
              </li>
            );
          })
        }
      </ul>

      <p class="mt-6">
        <a class="app-btn app-btn-solid" href={home} data-404-home>{copy.notFoundHome}</a>
      </p>
    </main>
  </Fragment>
</AppShell>
