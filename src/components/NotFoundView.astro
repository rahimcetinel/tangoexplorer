---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import { getNews } from '../lib/news';
import { homePath, ui, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getNews(locale);
const home = homePath(locale);
---

<AppShell
  title={`${copy.notFoundTitle} — ${copy.brand}`}
  description={copy.notFoundLead}
  locale={locale}
  posts={posts}
  robots="noindex"
>
  <Fragment slot="center">
    <Header
      locale={locale}
      crumbs={[
        { label: copy.home, href: home },
        { label: copy.notFoundTitle },
      ]}
    />
    <main id="main" class="app-page">
      <h1 class="app-page-title" data-i18n-en={ui.en.notFoundTitle} data-i18n-tr={ui.tr.notFoundTitle}>
        {copy.notFoundTitle}
      </h1>
      <p class="app-prose" data-i18n-en={ui.en.notFoundLead} data-i18n-tr={ui.tr.notFoundLead}>
        {copy.notFoundLead}
      </p>
      <p class="mt-6">
        <a class="app-btn app-btn-solid" href={home} data-404-home data-i18n-en={ui.en.notFoundHome} data-i18n-tr={ui.tr.notFoundHome}>
          {copy.notFoundHome}
        </a>
      </p>
    </main>
    {
      locale === 'en' && (
        <script is:inline>
          (function () {
            var path = location.pathname;
            if (path !== '/tr' && path.indexOf('/tr/') !== 0) return;
            document.documentElement.lang = 'tr';
            document.querySelectorAll('[data-i18n-tr]').forEach(function (el) {
              var text = el.getAttribute('data-i18n-tr');
              if (text) el.textContent = text;
            });
            var homeLink = document.querySelector('[data-404-home]');
            if (homeLink) homeLink.setAttribute('href', '/tr');
          })();
        </script>
      )
    }
  </Fragment>
  <Fragment slot="detail">
    <div class="app-detail-inner">
      <p class="app-detail-eyebrow">{copy.brand}</p>
      <p class="text-sm text-ink-soft">{copy.footerBlurb}</p>
    </div>
  </Fragment>
</AppShell>
