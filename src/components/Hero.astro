---
import { ui, type Locale } from '../lib/i18n';
import type { BoardStats } from '../lib/stats';

interface Props {
  locale: Locale;
  stats: BoardStats;
}

const { locale, stats } = Astro.props;
const copy = ui[locale];
---

<section class="app-hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="app-hero-title">{copy.heroTitle}</h1>
  <p class="app-hero-lede">{copy.heroLede}</p>
  <p class="app-hero-meta">
    <span><b>{stats.total}</b> {copy.heroStatEvents}</span>
    <span aria-hidden="true">·</span>
    <span><b>{stats.countries}</b> {copy.heroStatCountries}</span>
    <span aria-hidden="true">·</span>
    <span class="is-accent"><b>{stats.today}</b> {copy.heroToday.toLowerCase()}</span>
    <span aria-hidden="true">·</span>
    <span><b>{stats.thisWeekend}</b> {copy.heroThisWeekend.toLowerCase()}</span>
    <span aria-hidden="true">·</span>
    <span><b>{stats.thisWeek}</b> {copy.heroThisWeek.toLowerCase()}</span>
  </p>
</section>
