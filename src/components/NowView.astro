---
import AppShell from '../layouts/AppShell.astro';
import Header from '../components/Header.astro';
import milongaData from '../data/hoy-milongas.json';
import { getNews } from '../lib/news';
import { homePath, ui } from '../lib/i18n';
import type { HoyData, Milonga } from '../lib/hoy';
import { buildNowData } from '../lib/now-data';

const copy = ui.en;
const posts = await getNews('en');
const milongas = ((milongaData as HoyData).items ?? []) as Milonga[];
const { events, milongas: tonightMilongas, coords: cityCoords } = buildNowData(posts, milongas);

const cities = [
  ...new Set([
    ...events.map((event) => event.ci),
    ...tonightMilongas.map((item) => item.c),
  ].filter(Boolean)),
].sort((a, b) => a.localeCompare(b, 'en'));
---

<AppShell
  title={`Happening now — ${copy.brand}`}
  description="Tango events running today and milongas playing tonight, near your city."
  locale="en"
  mode="page"
  posts={posts}
>
  <Fragment slot="center">
    <Header
      locale="en"
      crumbs={[
        { label: copy.home, href: homePath('en') },
        { label: 'Happening now' },
      ]}
    />
    <main id="main" class="app-page now-page" data-now-page>
      <h1 class="app-page-title">Happening now</h1>
      <p class="app-prose">
        Events running today and milongas playing tonight. Pick your city once; we remember it and include
        nearby towns within about 150 km.
      </p>

      <div class="app-now-controls">
        <label class="app-now-field">
          <span>Your city</span>
          <input type="text" list="now-cities" data-now-city autocomplete="off" placeholder="Istanbul, Köln…" />
        </label>
        <button type="button" class="app-btn" data-now-locate>Use my location</button>
      </div>
      <datalist id="now-cities">
        {cities.map((city) => <option value={city} />)}
      </datalist>

      <p class="app-now-status" data-now-status aria-live="polite"></p>
      <div class="app-now-results" data-now-results></div>
      <noscript>
        <p class="app-prose">This page needs JavaScript to use your city. The milongas page lists tonight's options by city.</p>
      </noscript>

      <script type="application/json" data-now-events set:html={JSON.stringify(events)} />
      <script type="application/json" data-now-milongas set:html={JSON.stringify(tonightMilongas)} />
      <script type="application/json" data-now-coords set:html={JSON.stringify(cityCoords)} />
    </main>
  </Fragment>
</AppShell>
<script>
  import { initNow } from '../scripts/now';
  initNow();
</script>
