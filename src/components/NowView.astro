---
import AppShell from '../layouts/AppShell.astro';
import Header from '../components/Header.astro';
import milongaData from '../data/hoy-milongas.json';
import { getNews } from '../lib/news';
import { homePath, ui } from '../lib/i18n';
import type { HoyData, Milonga } from '../lib/hoy';
import { buildNowData } from '../lib/now-data';

const copy = ui.en;
const posts = await getNews('en');
const milongas = ((milongaData as HoyData).items ?? []) as Milonga[];
const {
  coords: cityCoords,
  cities,
  countries,
  allEvents,
  allMilongas,
} = buildNowData(posts, milongas);
---

<AppShell
  title={`Happening now — ${copy.brand}`}
  description="Tango events running today and milongas playing tonight, near your city."
  locale="en"
  mode="page"
  posts={posts}
>
  <Fragment slot="center">
    <Header
      locale="en"
      crumbs={[
        { label: copy.home, href: homePath('en') },
        { label: 'Happening now' },
      ]}
    />
    <main id="main" class="app-page now-page" data-now-page>
      <h1 class="app-page-title">Happening now</h1>
      <p class="app-prose">
        Events and milongas near you — today, this week or this month. Pick your city once; we remember it and
        include nearby towns within about 150 km.
      </p>

      <form class="app-now-controls" role="search" data-now-form>
        <label class="app-now-field">
          <span>City or country</span>
          <input
            type="search"
            name="place"
            data-now-city
            autocomplete="off"
            autocapitalize="words"
            spellcheck="false"
            data-1p-ignore="true"
            data-lpignore="true"
            placeholder="Istanbul, Köln, Germany…"
            aria-describedby="now-hint"
          />
        </label>
        <button type="submit" class="app-btn app-btn-solid">Show</button>
        <button type="button" class="app-btn" data-now-locate>Use my location</button>
      </form>
      <p class="app-now-hint" id="now-hint">
        Type a city, or a country to see everything happening there.
      </p>

      <div class="app-now-scopes" role="group" aria-label="Time range">
        <button type="button" data-now-when="today" aria-pressed="true">Today</button>
        <button type="button" data-now-when="week" aria-pressed="false">This week</button>
        <button type="button" data-now-when="month" aria-pressed="false">This month</button>
      </div>

      <p class="app-now-status" data-now-status aria-live="polite"></p>
      <div class="app-now-results" data-now-results></div>
      <noscript>
        <p class="app-prose">This page needs JavaScript to use your city. The milongas page lists tonight's options by city.</p>
      </noscript>

      <script type="application/json" data-now-coords set:html={JSON.stringify(cityCoords)} />
      <script type="application/json" data-now-cities set:html={JSON.stringify(cities)} />
      <script type="application/json" data-now-countries set:html={JSON.stringify(countries)} />
      <script type="application/json" data-now-all-events set:html={JSON.stringify(allEvents)} />
      <script type="application/json" data-now-all-milongas set:html={JSON.stringify(allMilongas)} />
    </main>
  </Fragment>
</AppShell>
<script>
  import { initNow } from '../scripts/now';
  initNow();
</script>
