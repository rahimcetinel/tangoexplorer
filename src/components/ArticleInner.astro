---
import { render } from 'astro:content';
import EventBox from './EventBox.astro';
import EventActions from './EventActions.astro';
import EventImage from './EventImage.astro';
import {
  categoryLabels,
  categoryPath,
  formatNewsDate,
  kindLabels,
  newsPath,
  ui,
  type Locale,
} from '../lib/i18n';
import { getNews, newsSlug, type NewsEntry } from '../lib/news';
import { eventDurationDays, whenBadge } from '../lib/calendar';
import { formatEventRange, groupingDate, monthLabel } from '../lib/timeline';
import { regionLabels, regionOf, regionPath } from '../lib/regions';

interface Props {
  locale: Locale;
  post: NewsEntry;
  variant?: 'page' | 'panel';
}

const { locale, post, variant = 'page' } = Astro.props;
const copy = ui[locale];
const { Content } = await render(post);
const slug = newsSlug(post);
const d = post.data;
const pageUrl = new URL(newsPath(locale, slug), Astro.site ?? 'https://tangoexplorer.com').href;
const labels = categoryLabels[locale];
const kinds = kindLabels[locale];
const kind = d.kinds[0];
const duration = d.eventStart ? eventDurationDays(d.eventStart, d.eventEnd) : null;
const badge = whenBadge(d.eventStart);
const badgeLabel =
  badge === 'today' ? copy.whenToday : badge === 'tomorrow' ? copy.whenTomorrow : badge === 'this-week' ? copy.whenThisWeek : null;
const nearby = (await getNews(locale)).filter((item) => item.id !== post.id);
const sameCity = d.city ? nearby.filter((item) => item.data.city === d.city) : [];
const sameCountry = nearby.filter(
  (item) => item.data.country === d.country && !sameCity.some((cityItem) => cityItem.id === item.id),
);
const related = [...sameCity, ...sameCountry].slice(0, 3);
const place = d.eventLocation || [d.city, d.country].filter(Boolean).join(', ');
const dates = formatEventRange(d.eventStart, d.eventEnd) || d.eventWhen || '';
const month = monthLabel(groupingDate(post), locale);
const region = regionOf(d.country);
---

<div data-article>
  <p class="app-kicker">
    {region ? (
      <a href={regionPath(locale, region)}>{regionLabels[locale][region]}</a>
    ) : (
      <a href={categoryPath(locale, d.category)}>{labels[d.category]}</a>
    )}
    {kind && <> · {kinds[kind]}</>}
    {place && <> · {place}</>}
    <> · {month}</>
    {badgeLabel && <span class="app-when-badge">{badgeLabel}</span>}
  </p>
  {
    variant === 'page' ? (
      <h1 class="app-article-title" tabindex="-1">
        {d.title}
      </h1>
    ) : (
      <h2 class="app-article-title" tabindex="-1">
        {d.title}
      </h2>
    )
  }
  <p class="app-lede">{d.summary}</p>
  {
    d.image && (
      <div class="app-heroimg">
        <EventImage
          src={d.image}
          alt={d.eventName || d.title}
          initialsFrom={d.title}
          eager={variant === 'page'}
          sizes="(min-width: 860px) 720px, 100vw"
        />
        {d.imageCredit && (
          <p class="app-image-credit">
            {copy.imageCredit}: {d.imageCredit}
          </p>
        )}
      </div>
    )
  }
  <div class:list={['app-article-body', variant === 'page' && 'drop-cap']}>
    <Content />
  </div>
  <EventBox post={post} locale={locale} duration={duration} showImage={false} />
  <EventActions locale={locale} post={post} pageUrl={pageUrl} permalink={variant === 'panel'} />
  <p class="app-timeline-pos">
    {copy.timelinePosition}: <b>{month}</b>
    {dates && <> · {dates}</>}
    <> · {copy.addedOn} {formatNewsDate(d.date, locale)}</>
  </p>
  {
    related.length > 0 && (
      <section class="app-related">
        <h3 class="app-related-title">{copy.relatedNearby}</h3>
        <ul>
          {related.map((item) => (
            <li>
              <a data-detail-link href={newsPath(locale, newsSlug(item))}>
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</div>
