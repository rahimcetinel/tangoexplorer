---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import { getBoardNews } from '../lib/news';
import { homePath, ui, type Locale } from '../lib/i18n';
import { FEED_PATH, GITHUB_URL, SUBMIT_EVENT_URL } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getBoardNews(locale);
const description =
  'What TangoExplorer covers, where the events come from, and how to submit or correct a listing.';
---

<AppShell title={`${copy.aboutTitle} — ${copy.brand}`} description={description} locale={locale} posts={posts}>
  <Fragment slot="center">
    <Header
      locale={locale}
      crumbs={[
        { label: copy.home, href: homePath(locale) },
        { label: copy.aboutTitle },
      ]}
    />
    <main id="main" class="app-page">
      <h1 class="app-page-title">{copy.aboutTitle}</h1>
      <div class="app-prose">
        <p>{copy.aboutP1}</p>
        <p>{copy.aboutP2}</p>
        <h2>{copy.aboutSources}</h2>
        <ul>
          <li>
            <a href="https://tangocat.net/" target="_blank" rel="noopener noreferrer">Tangocat</a>
            — {copy.aboutTangocat}
          </li>
          <li>
            <a href="https://hoy-milonga.com/turkiye/tr" target="_blank" rel="noopener noreferrer">Hoy Milonga Türkiye</a>
            {' — '}{copy.aboutHoy}
          </li>
          <li>{copy.aboutSocial}</li>
        </ul>
        <p>{copy.aboutEventLinks}</p>

        <h2 id="contribute">{copy.aboutContribute}</h2>
        <p>{copy.aboutContributeP}</p>
        <ul>
          <li>
            <a href={SUBMIT_EVENT_URL} target="_blank" rel="noopener noreferrer">{copy.aboutSubmitEvent}</a>
          </li>
          <li>
            <a href={`${GITHUB_URL}/issues/new?template=correction.yml`} target="_blank" rel="noopener noreferrer">
              {copy.aboutReportCorrection}
            </a>
          </li>
          <li>
            <a href={FEED_PATH}>{copy.aboutFeed}</a>
          </li>
          <li>
            <a href="/cal/all.ics">Calendar feed (.ics)</a>
          </li>
        </ul>
      </div>
    </main>
  </Fragment>
  <Fragment slot="detail">
    <div class="app-detail-inner">
      <p class="app-detail-eyebrow">{copy.aboutTitle}</p>
      <p class="text-sm text-ink-soft">{copy.footerBlurb}</p>
    </div>
  </Fragment>
</AppShell>
