---
import AppShell from '../layouts/AppShell.astro';
import Header from './Header.astro';
import { getBoardNews } from '../lib/news';
import { homePath, ui, type Locale } from '../lib/i18n';
import { FEED_PATH } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const posts = await getBoardNews(locale);
const description =
  'What TangoExplorer covers, where the events come from, and how to submit or correct a listing.';
---

<AppShell title={`${copy.aboutTitle} — ${copy.brand}`} description={description} locale={locale} posts={posts}>
  <Fragment slot="center">
    <Header
      locale={locale}
      crumbs={[
        { label: copy.home, href: homePath(locale) },
        { label: copy.aboutTitle },
      ]}
    />
    <main id="main" class="app-page">
      <h1 class="app-page-title">{copy.aboutTitle}</h1>
      <div class="app-prose">
        <p>{copy.aboutP1}</p>
        <p>{copy.aboutP2}</p>
        <h2>{copy.aboutSources}</h2>
        <ul>
          <li>
            <a href="https://tangocat.net/" target="_blank" rel="noopener noreferrer">Tangocat</a>
            — {copy.aboutTangocat}
          </li>
          <li>
            <a href="https://hoy-milonga.com/turkiye/tr" target="_blank" rel="noopener noreferrer">Hoy Milonga Türkiye</a>
            {' — '}{copy.aboutHoy}
          </li>
          <li>
            <a href="https://tango-calendar.de/termine/" target="_blank" rel="noopener noreferrer">tango-calendar.de</a>
            {' — '}{copy.aboutTangoCalendar}
          </li>
          <li>
            <a href="https://tangokalendern.se/" target="_blank" rel="noopener noreferrer">tangokalendern.se</a>
            {' — '}{copy.aboutSweden}
          </li>
          <li>
            <a href="https://milongas.ch/" target="_blank" rel="noopener noreferrer">milongas.ch</a>
            {' — '}{copy.aboutSwitzerland}
          </li>
          <li>
            <a href="https://tango.oslo.no/" target="_blank" rel="noopener noreferrer">tango.oslo.no</a>
            {' — '}{copy.aboutOslo}
          </li>
          <li>
            <a href="https://tango-wien.at/kalender" target="_blank" rel="noopener noreferrer">tango-wien.at</a>
            {' — '}{copy.aboutVienna}
          </li>
          <li>
            <a href="https://www.faitango.it/agenda-eventi" target="_blank" rel="noopener noreferrer">FAItango</a>
            {' — '}{copy.aboutItaly}
          </li>
          <li>
            <a href="https://agendadeltango.com/milongas/" target="_blank" rel="noopener noreferrer">Agenda del Tango</a>
            {' — '}{copy.aboutSpain}
          </li>
          <li>
            <a href="https://londonmilongas.co.uk/calendar/" target="_blank" rel="noopener noreferrer">London Milongas</a>
            {' — '}{copy.aboutLondon}
          </li>
          <li>
            <a href="https://www.tangokalender.nl/evenementagenda.aspx" target="_blank" rel="noopener noreferrer">tangokalender.nl</a>
            {' — '}{copy.aboutNetherlands}
          </li>
          <li>{copy.aboutSocial}</li>
        </ul>

        <h2 id="contribute">{copy.aboutContribute}</h2>
        <p>{copy.aboutContributeP}</p>
        <ul>
          <li>
            <a href={FEED_PATH}>{copy.aboutFeed}</a>
          </li>
          <li>
            <a href="/cal/all.ics">Calendar feed (.ics)</a>
          </li>
        </ul>
      </div>
    </main>
  </Fragment>
  <Fragment slot="detail">
    <div class="app-detail-inner">
      <p class="app-detail-eyebrow">{copy.aboutTitle}</p>
      <p class="text-sm text-ink-soft">{copy.footerBlurb}</p>
    </div>
  </Fragment>
</AppShell>
