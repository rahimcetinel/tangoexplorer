---
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import { homePath, ui, type Locale } from '../lib/i18n';
import type { NewsEntry } from '../lib/news';
import type { OgType } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  mode?: 'home' | 'category' | 'milonga' | 'page';
  newsSlug?: string;
  posts: NewsEntry[];
  ogImage?: string;
  ogType?: OgType;
  robots?: string;
  jsonLd?: object[];
  closePath?: string;
}

const {
  title,
  description,
  locale,
  mode = 'page',
  newsSlug,
  posts,
  ogImage,
  ogType,
  robots,
  jsonLd,
  closePath,
} = Astro.props;
const copy = ui[locale];
const isBoard = mode === 'home' || mode === 'category' || mode === 'milonga';
const drawer = mode === 'home' || mode === 'category';
const resolvedClosePath = closePath ?? homePath(locale);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  ogImage={ogImage}
  ogType={ogType}
  newsSlug={newsSlug}
  robots={robots}
  jsonLd={jsonLd}
>
  <div
    class="app-shell"
    data-app-shell
    data-mode={mode}
    data-drawer={drawer ? '' : undefined}
    data-locale={locale}
    data-home-path={homePath(locale)}
    data-close-path={isBoard ? resolvedClosePath : undefined}
    data-i18n-count={locale === 'tr' ? '{n} haber' : '{n} stories'}
  >
    <TopBar locale={locale} mode={mode} posts={posts} newsSlug={newsSlug} />
    <div class="app-body">
      <div class="app-center">
        <slot name="center" />
      </div>
      <aside
        class="app-detail"
        data-detail-panel={isBoard ? '' : undefined}
        aria-label={copy.detailEyebrow}
        id={isBoard ? 'detail-panel' : undefined}
      >
        <slot name="detail" />
      </aside>
    </div>
    <div class="app-detail-backdrop" data-detail-backdrop hidden></div>
  </div>
</BaseLayout>
